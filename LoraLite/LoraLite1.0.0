// ==UserScript==
// @name         LoraCord Lite
// @namespace    https://github.com/yourname/loracord
// @version      1.0.0
// @description  Small and reliable LoraCord Discord dashboard
// @match        https://discord.com/*
// @grant        none
// @run-at       document-idle
// ==/UserScript==

(() => {
    "use strict";

    const KEY = "loracord_lite";
    const load = () => JSON.parse(localStorage.getItem(KEY) || "{}");
    const save = data => localStorage.setItem(KEY, JSON.stringify(data));

    const settings = {
        accent: "#5865f2",
        enabled: true,
        ...load()
    };

    save(settings);

    const style = document.createElement("style");
    style.textContent = `
        #loracord-launcher {
            position: fixed;
            right: 18px;
            bottom: 18px;
            width: 44px;
            height: 44px;
            border: 0;
            border-radius: 12px;
            background: ${settings.accent};
            color: white;
            font-size: 20px;
            font-weight: bold;
            cursor: pointer;
            z-index: 999999999;
            box-shadow: 0 8px 25px rgba(0,0,0,.4);
        }

        #loracord {
            position: fixed;
            right: 18px;
            bottom: 72px;
            width: 300px;
            background: #18191c;
            color: white;
            border: 1px solid #2b2d31;
            border-radius: 14px;
            overflow: hidden;
            font-family: Arial, sans-serif;
            z-index: 999999998;
            box-shadow: 0 20px 60px rgba(0,0,0,.6);
            display: none;
        }

        #loracord.open {
            display: block;
        }

        .lc-head {
            padding: 14px;
            background: #111214;
            font-weight: bold;
            display: flex;
            justify-content: space-between;
        }

        .lc-nav {
            display: flex;
            border-bottom: 1px solid #2b2d31;
        }

        .lc-nav button {
            flex: 1;
            padding: 9px;
            border: 0;
            background: transparent;
            color: #aaa;
            cursor: pointer;
        }

        .lc-nav button.active {
            color: white;
            background: #2b2d31;
        }

        .lc-page {
            padding: 14px;
        }

        .lc-button {
            width: 100%;
            padding: 9px;
            margin-top: 7px;
            border: 0;
            border-radius: 8px;
            background: #2b2d31;
            color: white;
            cursor: pointer;
            text-align: left;
        }

        .lc-button:hover {
            background: ${settings.accent};
        }

        .lc-input {
            width: 100%;
            box-sizing: border-box;
            padding: 9px;
            margin-top: 7px;
            border: 1px solid #2b2d31;
            border-radius: 8px;
            background: #111214;
            color: white;
            outline: none;
        }

        .lc-title {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 6px;
        }

        .lc-text {
            color: #aaa;
            font-size: 12px;
            line-height: 1.5;
        }
    `;

    document.head.appendChild(style);

    const launcher = document.createElement("button");
    launcher.id = "loracord-launcher";
    launcher.textContent = "✦";

    const panel = document.createElement("div");
    panel.id = "loracord";

    panel.innerHTML = `
        <div class="lc-head">
            <span>LoraCord</span>
            <span>1.0</span>
        </div>

        <div class="lc-nav">
            <button data-page="home" class="active">Home</button>
            <button data-page="plugins">Plugins</button>
            <button data-page="settings">Settings</button>
        </div>

        <div class="lc-page" id="lc-page"></div>
    `;

    document.body.appendChild(launcher);
    document.body.appendChild(panel);

    const page = panel.querySelector("#lc-page");
    const navButtons = panel.querySelectorAll(".lc-nav button");

    function render(name) {
        if (name === "home") {
            page.innerHTML = `
                <div class="lc-title">Welcome</div>

                <div class="lc-text">
                    Small LoraCord starter dashboard.
                </div>

                <button class="lc-button" id="quick">
                    Insert Quick Reply
                </button>

                <button class="lc-button" id="copy">
                    Copy Current URL
                </button>
            `;

            page.querySelector("#quick").onclick = () => {
                const box =
                    document.querySelector('[role="textbox"]');

                if (!box) {
                    alert("Open a Discord text channel first.");
                    return;
                }

                box.focus();

                document.execCommand(
                    "insertText",
                    false,
                    "Hello! This is a LoraCord quick reply."
                );
            };

            page.querySelector("#copy").onclick = async () => {
                await navigator.clipboard.writeText(location.href);
            };
        }

        if (name === "plugins") {
            page.innerHTML = `
                <div class="lc-title">Plugins</div>

                <div class="lc-text">
                    Basic browser-safe plugins.
                </div>

                <button class="lc-button" id="theme">
                    Toggle Accent
                </button>

                <button class="lc-button" id="fake">
                    Toggle FakeNitro Cosmetic
                </button>
            `;

            page.querySelector("#theme").onclick = () => {
                settings.accent =
                    settings.accent === "#5865f2"
                        ? "#00c8ff"
                        : "#5865f2";

                save(settings);

                style.textContent =
                    style.textContent
                        .replace(
                            /background: #(?:5865f2|00c8ff)/g,
                            `background: ${settings.accent}`
                        );

                launcher.style.background =
                    settings.accent;
            };

            page.querySelector("#fake").onclick = () => {
                document.body.classList.toggle(
                    "loracord-fake-nitro"
                );

                notify(
                    document.body.classList.contains(
                        "loracord-fake-nitro"
                    )
                        ? "FakeNitro cosmetic enabled."
                        : "FakeNitro cosmetic disabled."
                );
            };
        }

        if (name === "settings") {
            page.innerHTML = `
                <div class="lc-title">Settings</div>

                <div class="lc-text">
                    Change the LoraCord accent color.
                </div>

                <input
                    class="lc-input"
                    id="accent"
                    type="color"
                    value="${settings.accent}"
                >

                <button class="lc-button" id="save">
                    Save
                </button>
            `;

            page.querySelector("#save").onclick = () => {
                settings.accent =
                    page.querySelector("#accent").value;

                save(settings);

                launcher.style.background =
                    settings.accent;

                location.reload();
            };
        }
    }

    function notify(text) {
        const box = document.createElement("div");

        box.textContent = text;

        Object.assign(box.style, {
            position: "fixed",
            right: "18px",
            bottom: "18px",
            padding: "10px 14px",
            background: "#18191c",
            color: "white",
            borderRadius: "8px",
            zIndex: "999999999",
            fontFamily: "Arial"
        });

        document.body.appendChild(box);

        setTimeout(() => box.remove(), 1800);
    }

    launcher.onclick = () => {
        panel.classList.toggle("open");
    };

    navButtons.forEach(button => {
        button.onclick = () => {
            navButtons.forEach(b => b.classList.remove("active"));
            button.classList.add("active");
            render(button.dataset.page);
        };
    });

    document.addEventListener("keydown", event => {
        if (
            event.ctrlKey &&
            event.shiftKey &&
            event.key.toLowerCase() === "l"
        ) {
            event.preventDefault();
            panel.classList.toggle("open");
        }

        if (event.key === "Escape") {
            panel.classList.remove("open");
        }
    });

    // Cosmetic-only FakeNitro indicator.
    const cosmetic = document.createElement("style");

    cosmetic.textContent = `
        body.loracord-fake-nitro
        [class*="premium"],
        body.loracord-fake-nitro
        [class*="nitro"] {
            filter: drop-shadow(
                0 0 8px
                rgba(255,115,250,.45)
            );
        }
    `;

    document.head.appendChild(cosmetic);

    render("home");
})();
